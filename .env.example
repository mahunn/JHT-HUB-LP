# ==============================================================================
# JHT HUB E-Commerce - Environment Variables
# ==============================================================================

# Admin Authentication
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=adminjhthub1

# ==============================================================================
# Cloud Database Persistence (Choose EITHER Option 1 or Option 2 for Vercel)
# ==============================================================================

# OPTION 1: Supabase (Recommended - Free Forever, Never Deletes Orders)
# 1. Create a free project at https://supabase.com
# 2. In SQL Editor, run the script from `supabase_schema.sql`
# 3. Copy Project URL and API Key from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# OPTION 2: Vercel KV / Upstash Redis (1-Click in Vercel Storage)
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-upstash-token
